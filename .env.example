# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="http://localhost:3000"

# G-Events Data Modes:
# By default, Mode A (Local Demo Mode) is ACTIVE with rich deterministic demo data
# persisted in localStorage.
# To connect to real Supabase (Mode B), provide your project credentials below:
# (Client-side variables in Vite must use VITE_ prefix)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

